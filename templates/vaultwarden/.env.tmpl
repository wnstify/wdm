# Vaultwarden — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/vaultwarden/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update; regenerable=false
# secrets are read back from the existing .env at update time.

# --- Postgres identifiers (catalog-fixed literals) ---
# Postgres role and database names are SQL identifiers — they cannot be
# parameterized via SQL placeholders, only quoted string values can. The
# init-data.sh sidecar interpolates these via shell expansion inside CREATE
# USER / GRANT statements, so the values are fixed at the catalog/template
# layer and never user-supplied. Passwords below DO flow through as quoted
# SQL string literals — crypto/rand entropy makes identifier injection
# structurally impossible.
POSTGRES_USER=vaultwarden_admin
POSTGRES_DB=vaultwarden
POSTGRES_NON_ROOT_USER=vaultwarden

# --- Postgres credentials (catalog placeholders, regenerable=false) ---------
# regenerable=false: rotating these post-install requires ALTER USER inside
# the postgres container, which wdm does not orchestrate. Update path reuses
# the existing values via state.ReadStackEnv. Both are
# base64url-encoded so they carry no ':' / '@' / '$' that would break the
# DATABASE_URL vaultwarden connects with.
POSTGRES_PASSWORD={{ .POSTGRES_PASSWORD }}
POSTGRES_NON_ROOT_PASSWORD={{ .POSTGRES_NON_ROOT_PASSWORD }}

# --- Admin credential (catalog placeholder, encoding: argon2id, regenerable=
#     false) ----------------------------------------------------------------
# ADMIN_TOKEN gates vaultwarden's /admin panel. With encoding: argon2id wdm
# generates a strong random plaintext, persists ONLY the one-way argon2id PHC
# hash here (with its '$' signs doubled to '$$' so Compose does not treat them
# as variable references), and surfaces the plaintext to the operator once on
# the install finish screen. The plaintext cannot be re-derived from the PHC,
# so this is regenerable=false: wdm reuses the existing hash on every update.
ADMIN_TOKEN={{ .ADMIN_TOKEN }}

# --- Public URL (derived via env templating) ---
# DOMAIN is the FULL external URL with scheme (https://host), required for
# WebAuthn/U2F two-factor, push notifications, and the links vaultwarden emits.
# Derived from VAULTWARDEN_DOMAIN so the user supplies one input. NO trailing
# slash. VAULTWARDEN_DOMAIN is persisted as its own key so the update path
# can read the recorded input back from the existing .env.
VAULTWARDEN_DOMAIN={{ .VAULTWARDEN_DOMAIN }}
DOMAIN=https://{{ .VAULTWARDEN_DOMAIN }}

# --- Listen port (catalog-fixed literal) ------------------------------------
# vaultwarden's internal Rocket listen port. 8080 is unprivileged, so the
# container binds it without NET_BIND_SERVICE. The Compose template binds
# 127.0.0.1:8080 -> this port.
ROCKET_PORT=8080

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scheduled tasks). wdm resolves empty
# input to the host timezone at install planning time.
TZ={{ .TZ }}

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_POSTGRES={{ .MEMORY_LIMIT_POSTGRES }}
CPUS_LIMIT_POSTGRES={{ .CPUS_LIMIT_POSTGRES }}
PIDS_LIMIT_POSTGRES={{ .PIDS_LIMIT_POSTGRES }}

MEMORY_LIMIT_VAULTWARDEN={{ .MEMORY_LIMIT_VAULTWARDEN }}
CPUS_LIMIT_VAULTWARDEN={{ .CPUS_LIMIT_VAULTWARDEN }}
PIDS_LIMIT_VAULTWARDEN={{ .PIDS_LIMIT_VAULTWARDEN }}
