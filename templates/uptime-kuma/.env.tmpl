# Uptime Kuma — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/uptime-kuma/.env with mode 0600 at install
# time. Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update.

# --- Database identifiers (catalog-fixed literals) ---
# MariaDB's MARIADB_DATABASE and MARIADB_USER env vars drive SQL DDL inside
# the official image entrypoint (CREATE DATABASE / CREATE USER). SQL
# identifiers cannot be parameterized — only quoted string values can — so
# these names are fixed at the catalog/template layer, never user-supplied.
UPTIME_KUMA_DB_NAME=uptime_kuma
UPTIME_KUMA_DB_USERNAME=uptime_kuma

# --- Database credentials (catalog placeholders, regenerable=false) ---------
MARIADB_ROOT_PASSWORD={{ .MARIADB_ROOT_PASSWORD }}
UPTIME_KUMA_DB_PASSWORD={{ .UPTIME_KUMA_DB_PASSWORD }}

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps, scheduled monitor checks). wdm resolves
# empty input to the host timezone at install planning time.
TZ={{ .TZ }}

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_MARIADB={{ .MEMORY_LIMIT_MARIADB }}
CPUS_LIMIT_MARIADB={{ .CPUS_LIMIT_MARIADB }}
PIDS_LIMIT_MARIADB={{ .PIDS_LIMIT_MARIADB }}

MEMORY_LIMIT_UPTIME_KUMA={{ .MEMORY_LIMIT_UPTIME_KUMA }}
CPUS_LIMIT_UPTIME_KUMA={{ .CPUS_LIMIT_UPTIME_KUMA }}
PIDS_LIMIT_UPTIME_KUMA={{ .PIDS_LIMIT_UPTIME_KUMA }}
