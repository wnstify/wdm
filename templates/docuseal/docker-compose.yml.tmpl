# DocuSeal — Hardened Docker Compose (wdm template, document signing)
# Two services: postgres backend + the docuseal all-in-one app container.
#
# Security baseline:
#   - cap_drop: ALL with minimum caps only — postgres adds the five init /
#     privilege-drop caps; docuseal runs as container root and needs ZERO
#     added caps (probe-verified), so it carries cap_drop: ALL with no cap_add.
#   - security_opt: no-new-privileges; ipc: private on every container
#   - Two-network isolation (wdm creates internal networks at install):
#       docuseal-front  (external) — reverse proxy reaches docuseal here
#       docuseal-db     (internal) — docuseal <-> postgres only, no internet
#   - deploy.resources limits incl. pids on every container
#   - tmpfs for postgres ephemeral writes; healthchecks gate startup via
#     depends_on
#   - 127.0.0.1 port binding only — reverse proxy in front for TLS
#   - init-data.sh creates a non-root DB user so docuseal never has DB superuser
#   - SCRAM-SHA-256 password auth on postgres (stronger than the default md5)
#   - postgres and docuseal data dirs are named volumes (db_storage,
#     docuseal_data), not bind mounts — wdm does not pre-create bind dirs, and
#     a host bind would be created root-owned and break the app's writes
#
# wdm renders this template into ~/docker/docuseal/docker-compose.yml at install
# time and binds ${VAR} references at `docker compose up -d` time via
# --env-file ~/docker/docuseal/.env (mode 0600). init-data.sh ships as a catalog
# additional_files entry and is written verbatim
# alongside the rendered compose + env files.

name: docuseal

services:

  postgres:
    image: postgres:18.4
    container_name: docuseal-postgres
    restart: unless-stopped
    # user-editable overlay (added knobs; never regenerated)
    env_file:
      - .env.user
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_NON_ROOT_USER: ${POSTGRES_NON_ROOT_USER}
      POSTGRES_NON_ROOT_PASSWORD: ${POSTGRES_NON_ROOT_PASSWORD}
      # SCRAM-SHA-256 password hashing instead of the historical md5 default.
      POSTGRES_HOST_AUTH_METHOD: scram-sha-256
      POSTGRES_INITDB_ARGS: --auth-host=scram-sha-256
      # Postgres 18 moved its default data dir under /var/lib/postgresql/18/.
      # Pin it back to /var/lib/postgresql/data so users upgrading from
      # postgres:17 don't need a data migration.
      PGDATA: /var/lib/postgresql/data
      TZ: ${TZ}
    volumes:
      # Named volume (not a bind mount): postgres self-chowns its PGDATA on
      # init, and a named volume keeps the data inside Docker rather than in a
      # host dir wdm would have to pre-create.
      - db_storage:/var/lib/postgresql/data
      - ./init-data.sh:/docker-entrypoint-initdb.d/init-data.sh:ro
    networks:
      - docuseal-db
    cap_drop:
      - ALL
    cap_add:
      # Minimum caps for the postgres entrypoint init + privilege drop to
      # postgres:postgres. No NET_* / SYS_*.
      - CHOWN
      - SETGID
      - SETUID
      - DAC_OVERRIDE
      - FOWNER
    security_opt:
      - no-new-privileges:true
    ipc: private
    tmpfs:
      - /tmp:size=64m
      - /var/run/postgresql:size=64m
    deploy:
      resources:
        limits:
          memory: ${MEMORY_LIMIT_POSTGRES}
          cpus: "${CPUS_LIMIT_POSTGRES}"
          pids: ${PIDS_LIMIT_POSTGRES}
        reservations:
          memory: 256m
          cpus: "0.25"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h localhost -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 30s

  docuseal:
    # All-in-one image: the Rails web app, a bundled Redis, and the Sidekiq
    # background-job worker all run inside the single container. No external
    # Redis service is needed (probe-verified for 3.0.3).
    image: docuseal/docuseal:3.0.3
    container_name: docuseal
    restart: unless-stopped
    # user-editable overlay (added knobs; never regenerated)
    env_file:
      - .env.user
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "127.0.0.1:3000:3000"  # localhost only — front with a reverse proxy
    environment:
      # External host docuseal builds absolute URLs from (signing-request
      # emails, share links). Derived from DOCUSEAL_DOMAIN in the .env.
      HOST: ${DOCUSEAL_HOST}
      # FORCE_SSL takes the public hostname (not a bare "true"): docuseal then
      # emits secure cookies and redirects HTTP -> HTTPS. TLS terminates at the
      # reverse proxy in front, so the app must know it is served over HTTPS.
      FORCE_SSL: ${DOCUSEAL_HOST}
      # --- Database connection (non-root user from init-data.sh) -----------
      # docuseal switches off its bundled SQLite to the external Postgres via
      # this single connection URL. The non-root user is created by
      # init-data.sh; the password is base64url-encoded so it carries no
      # ':' / '@' / '$' that would break the URL.
      DATABASE_URL: postgresql://${POSTGRES_NON_ROOT_USER}:${POSTGRES_NON_ROOT_PASSWORD}@postgres:5432/${POSTGRES_DB}
      # --- Secrets ---------------------------------------------------------
      # Rails session/cookie signing secret; required in production. Rotating
      # it invalidates outstanding signed cookies and sessions (no data loss).
      SECRET_KEY_BASE: ${SECRET_KEY_BASE}
      TZ: ${TZ}
    volumes:
      # Named volume (not a bind mount): docuseal persists uploaded documents,
      # generated PDFs, and disk-service state under /data/docuseal. A host
      # bind would be created root-owned by Docker and break the app's writes,
      # so wdm uses a named volume that stays inside Docker.
      - docuseal_data:/data/docuseal
    networks:
      - docuseal-front
      - docuseal-db
    cap_drop:
      - ALL
    # docuseal runs as container root and needs no added capabilities
    # (probe-verified): it binds the unprivileged port 3000 and writes its
    # named data volume without any of the chown/setuid caps a privilege-drop
    # entrypoint would require. cap_drop: ALL with no cap_add.
    security_opt:
      - no-new-privileges:true
    ipc: private
    deploy:
      resources:
        limits:
          memory: ${MEMORY_LIMIT_DOCUSEAL}
          cpus: "${CPUS_LIMIT_DOCUSEAL}"
          pids: ${PIDS_LIMIT_DOCUSEAL}
        reservations:
          memory: 256m
          cpus: "0.25"
    healthcheck:
      # The image ships wget but NOT curl, so the probe uses wget. /up is
      # Rails' built-in health endpoint and returns 200 only after database
      # migrations finish. First boot runs migrations + warms the bundled
      # Redis/Sidekiq, so start_period: 120s covers the ~40-60s cold start.
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1:3000/up >/dev/null 2>&1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

networks:
  # Front: reverse proxy reaches docuseal here (or via 127.0.0.1:3000).
  docuseal-front:
    external: true
  # Backend DB: docuseal <-> postgres only, no internet egress. wdm creates
  # this with --internal at install time.
  docuseal-db:
    external: true

volumes:
  # Postgres data dir. A named volume so wdm need not pre-create a host bind
  # dir; postgres self-chowns it on init. wdm's remove preserves named volumes
  # (never `docker compose down -v`) and lists them in the removal summary.
  db_storage:
  # docuseal app data (uploaded documents, generated PDFs, disk-service state).
  # A named volume so wdm need not pre-create a host bind dir the root-running
  # app would otherwise fail to write; preserved on remove like db_storage.
  docuseal_data:
