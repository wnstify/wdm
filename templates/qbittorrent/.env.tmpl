# qBittorrent — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/qbittorrent/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update.

# --- Privilege drop (PUID/PGID — built-in template vars).
#     wdm resolves PUID = os.Getuid() and PGID = os.Getgid() at install
#     time. The image entrypoint starts as root, chowns /config, then drops the
#     qbittorrent-nox process to this uid:gid. Never user-supplied. ----------
PUID={{ .UID }}
PGID={{ .GID }}

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scheduled tasks). wdm resolves empty
# input to the host timezone at install planning time.
TZ={{ .TZ }}

# --- Downloads library path (catalog placeholder, type: path) ---------------
# Absolute user-host path validated by internal/core at install planning time
# Path must exist, must be absolute, and must NOT live
# inside the stack directory; qbittorrent mounts it read-write at /downloads.
DOWNLOADS_PATH={{ .DOWNLOADS_PATH }}

# --- Image-required literals (catalog-fixed, not wdm placeholders) -----------
# QBT_LEGAL_NOTICE=confirm is mandatory: the image refuses to start until the
# legal notice is accepted. The port values match the compose binds and are
# the qBittorrent defaults. Edit them in the wdm template, not here — wdm
# regenerates this file on update.
QBT_LEGAL_NOTICE=confirm
QBT_WEBUI_PORT=8080
QBT_TORRENTING_PORT=6881

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_QBITTORRENT={{ .MEMORY_LIMIT_QBITTORRENT }}
CPUS_LIMIT_QBITTORRENT={{ .CPUS_LIMIT_QBITTORRENT }}
PIDS_LIMIT_QBITTORRENT={{ .PIDS_LIMIT_QBITTORRENT }}
