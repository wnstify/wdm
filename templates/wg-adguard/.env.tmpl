# wg-adguard — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/wg-adguard/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update; regenerable=false
# secrets are read back from the existing .env at update time.

# --- Public WireGuard endpoint (catalog placeholder, type: domain) ----------
# The hostname remote clients dial to reach the WireGuard listener. Rendered
# into wg-easy's INIT_HOST so generated client configs point at it. Not a URL —
# just the host (no scheme, no path).
WG_HOST={{ .WG_HOST }}

# --- wg-easy admin login (username is a catalog-fixed literal) ---------------
# The web UI admin username. Fixed at the template layer (never user-supplied);
# the password is the WG_EASY_PASSWORD secret below.
WG_EASY_ADMIN_USER=admin

# --- wg-easy admin password (catalog placeholder, encoding: base64url,
#     regenerable: false) ---------------------------------------------------
# Plaintext admin password for the wg-easy web UI. wg-easy hashes it internally
# (argon2) on first boot, so it MUST be the plaintext here (INIT_PASSWORD).
# base64url(32 bytes) is 43 chars, comfortably above wg-easy's 12-char minimum.
# regenerable=false: wg-easy persists the hash in its SQLite database on first
# boot; rotating the .env value later would not change the stored credential, so
# wdm reuses the existing value on update. This is your login —
# it lives in this file (~/docker/wg-adguard/.env), like the other plaintext
# login secrets in the catalog.
WG_EASY_PASSWORD={{ .WG_EASY_PASSWORD }}

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps, scheduled tasks). wdm resolves empty input
# to the host timezone at install planning time.
TZ={{ .TZ }}

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_WG_EASY={{ .MEMORY_LIMIT_WG_EASY }}
CPUS_LIMIT_WG_EASY={{ .CPUS_LIMIT_WG_EASY }}
PIDS_LIMIT_WG_EASY={{ .PIDS_LIMIT_WG_EASY }}

MEMORY_LIMIT_ADGUARD={{ .MEMORY_LIMIT_ADGUARD }}
CPUS_LIMIT_ADGUARD={{ .CPUS_LIMIT_ADGUARD }}
PIDS_LIMIT_ADGUARD={{ .PIDS_LIMIT_ADGUARD }}
