# Navidrome — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/navidrome/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update.

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scan schedule). wdm resolves empty
# input to the host timezone at install planning time.
TZ={{ .TZ }}

# --- Music library path (catalog placeholder, type: path) -------------------
# Absolute user-host path validated by internal/core at install planning time
# Path must exist, must be absolute, and must NOT live
# inside the stack directory; navidrome mounts it read-only at /music.
MUSIC_PATH={{ .MUSIC_PATH }}

# --- Navidrome runtime (catalog-fixed literals) -----------------------------
# These are not catalog placeholders — navidrome stays minimal (no
# declarations beyond the bind path). Edit them in the wdm template, not here:
# wdm regenerates this file on update.
ND_LOGLEVEL=info
ND_SCANSCHEDULE=1h
ND_SESSIONTIMEOUT=24h

# --- Optional integrations --------------------------------------------------
# Uncomment and fill in to enable. env_file picks these up at `up -d` time;
# they are not wdm placeholders, so wdm will not prompt for or manage them.
#   ND_BASEURL=/                       # set if served under a subpath
#   ND_LASTFM_APIKEY=                  # Last.fm scrobbling + artist images
#   ND_LASTFM_SECRET=
#   ND_SPOTIFY_ID=                     # Spotify artist images
#   ND_SPOTIFY_SECRET=

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_NAVIDROME={{ .MEMORY_LIMIT_NAVIDROME }}
CPUS_LIMIT_NAVIDROME={{ .CPUS_LIMIT_NAVIDROME }}
PIDS_LIMIT_NAVIDROME={{ .PIDS_LIMIT_NAVIDROME }}
