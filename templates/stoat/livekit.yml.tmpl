# Auto-generated by wdm — do not edit manually
# LiveKit voice/video SFU config. wdm renders this from the placeholder map at
# install (mode 0600 — it carries the redis password and the LiveKit key/secret)
# and bind-mounts it read-only into the livekit service at /etc/livekit.yml.
rtc:
  use_external_ip: true
  port_range_start: 50000
  port_range_end: 50100
  tcp_port: 7881

redis:
  address: redis:6379
  password: "{{ .REDIS_PASSWORD }}"

turn:
  enabled: false

keys:
  {{ .LIVEKIT_KEY }}: {{ .LIVEKIT_SECRET }}

webhook:
  api_key: {{ .LIVEKIT_KEY }}
  urls:
  - "http://voice-ingress:8500/worldwide"
