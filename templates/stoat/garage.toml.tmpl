# Auto-generated by wdm — do not edit manually
# Garage S3 storage config. wdm renders this from the placeholder map at install
# (mode 0600 — it carries the RPC/admin/metrics secrets) and bind-mounts it
# read-only into the garage service at /etc/garage.toml.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "garage:3901"
rpc_secret = "{{ .GARAGE_RPC_SECRET }}"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "{{ .GARAGE_ADMIN_TOKEN }}"
metrics_token = "{{ .GARAGE_METRICS_TOKEN }}"
