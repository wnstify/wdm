# Stoat — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/stoat/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update; regenerable=false
# secrets are read back from the existing .env at update time.
#
# Every generated secret is persisted here in .env so wdm can recover the
# regenerable=false values on update and register them with the redactor on
# reuse. The config-only secrets (the Garage RPC/metrics tokens, the LiveKit
# key/secret, and the file-encryption key) are ALSO rendered into the
# wdm-rendered config artifacts (secrets.env, garage.toml, livekit.yml) from the
# same placeholder map. They are not referenced as ${VAR} in the Compose file,
# so Compose never injects them into a container from .env — .env is purely the
# canonical recovery store for them. No PUID/PGID: data services use the
# gosu-drop posture, and LiveKit's run-as uid:gid is rendered directly from
# wdm's built-in .UID/.GID values so it can read livekit.yml mode 0600.

# --- Public identity --------------------------------------------------------
# The hostname Stoat serves. Used as the Caddy network alias on stoat-app and
# rendered into the config artifacts' URLs. A real FQDN is required — Stoat
# crash-loops on a dotless host.
STOAT_DOMAIN={{ .STOAT_DOMAIN }}

# --- Backend credentials (compose-substituted into the service env/command) -
# MONGO_ROOT_USER/PASSWORD seed the mongo root account; REDIS_PASSWORD is passed
# to redis-server --requirepass and the redis healthcheck; RABBIT_USER/PASSWORD
# seed the rabbitmq broker. regenerable=false secrets: each backend applies its
# password only at first init, so wdm reuses the existing value on update.
MONGO_ROOT_USER={{ .MONGO_ROOT_USER }}
MONGO_ROOT_PASSWORD={{ .MONGO_ROOT_PASSWORD }}
REDIS_PASSWORD={{ .REDIS_PASSWORD }}
RABBIT_USER={{ .RABBIT_USER }}
RABBIT_PASSWORD={{ .RABBIT_PASSWORD }}

# --- Garage bootstrap credentials (compose-substituted into garage-init env) -
# garage-init calls the Garage admin API with GARAGE_ADMIN_TOKEN and imports the
# S3 key pair (S3_ACCESS_KEY / S3_SECRET_KEY). The same access/secret pair is
# rendered into secrets.env so autumn reads the identical credential.
GARAGE_ADMIN_TOKEN={{ .GARAGE_ADMIN_TOKEN }}
S3_ACCESS_KEY={{ .S3_ACCESS_KEY }}
S3_SECRET_KEY={{ .S3_SECRET_KEY }}

# --- Config-artifact secrets (recovery store only) --------------------------
# These secrets are rendered into the config artifacts (garage.toml, livekit.yml,
# secrets.env), not substituted by Compose. They are persisted here so wdm can
# recover their regenerable=false values on update and register them with the
# redactor on reuse. They are not referenced as ${VAR} in the Compose file, so
# Compose never injects them into a container from .env.
GARAGE_RPC_SECRET={{ .GARAGE_RPC_SECRET }}
GARAGE_METRICS_TOKEN={{ .GARAGE_METRICS_TOKEN }}
LIVEKIT_KEY={{ .LIVEKIT_KEY }}
LIVEKIT_SECRET={{ .LIVEKIT_SECRET }}
FILES_ENCRYPTION_KEY={{ .FILES_ENCRYPTION_KEY }}

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scheduled tasks). wdm resolves empty
# input to the host timezone at install planning time.
TZ={{ .TZ }}

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract. The two init
#     containers carry fixed small limits in the Compose template and have no
#     band here. ----------------------------------------------------------------
MEMORY_LIMIT_DATABASE={{ .MEMORY_LIMIT_DATABASE }}
CPUS_LIMIT_DATABASE={{ .CPUS_LIMIT_DATABASE }}
PIDS_LIMIT_DATABASE={{ .PIDS_LIMIT_DATABASE }}

