# FreshRSS — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/freshrss/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update.

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + cron schedule). wdm resolves empty
# input to the host timezone at install planning time.
TZ={{ .TZ }}

# --- Feed refresh schedule --------------------------------------------------
# Minute field of the built-in crontab. Catalog default: 3,33 (every 30 min,
# staggered at HH:03 and HH:33). Examples:
#   */15    every 15 minutes
#   0       once an hour, on the hour
#   ""      empty string disables the internal cron entirely
CRON_MIN={{ .CRON_MIN }}

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_FRESHRSS={{ .MEMORY_LIMIT_FRESHRSS }}
CPUS_LIMIT_FRESHRSS={{ .CPUS_LIMIT_FRESHRSS }}
PIDS_LIMIT_FRESHRSS={{ .PIDS_LIMIT_FRESHRSS }}
