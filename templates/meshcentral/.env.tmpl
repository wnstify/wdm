# MeshCentral — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/meshcentral/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update.
#
# No database credentials live here: MongoDB runs with no authentication on the
# --internal meshcentral-db network (no internet egress, MeshCentral is the sole
# client). MeshCentral auto-persists its own session secret in its data volume,
# so wdm generates no secrets for this stack.

# --- Domain (config.json input) --------------------------------------------
# The public hostname MeshCentral serves. wdm renders it into config.json as the
# certificate / domain name; it is not consumed by docker-compose.yml directly
# (recorded here for operator visibility). Front MeshCentral with a reverse
# proxy that terminates TLS and forwards to 127.0.0.1:4430.
MESHCENTRAL_DOMAIN={{ .MESHCENTRAL_DOMAIN }}

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scheduled tasks). wdm resolves empty
# input to the host timezone at install planning time.
TZ={{ .TZ }}

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_MONGODB={{ .MEMORY_LIMIT_MONGODB }}
CPUS_LIMIT_MONGODB={{ .CPUS_LIMIT_MONGODB }}
PIDS_LIMIT_MONGODB={{ .PIDS_LIMIT_MONGODB }}

MEMORY_LIMIT_MESHCENTRAL={{ .MEMORY_LIMIT_MESHCENTRAL }}
CPUS_LIMIT_MESHCENTRAL={{ .CPUS_LIMIT_MESHCENTRAL }}
PIDS_LIMIT_MESHCENTRAL={{ .PIDS_LIMIT_MESHCENTRAL }}
