# Syncthing — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/syncthing/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update.

# --- Container user (PUID/PGID — built-in template vars).
#     wdm resolves PUID = os.Getuid() and PGID = os.Getgid() at install
#     time so Syncthing's entrypoint chowns /var/syncthing and drops to the
#     host user that owns the stack directory. Never user-supplied. ----------
PUID={{ .UID }}
PGID={{ .GID }}

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scheduled rescans). wdm resolves empty
# input to the host timezone at install planning time.
TZ={{ .TZ }}

# --- GUI bind address (catalog-fixed literal) -------------------------------
# Bind the web UI on all container interfaces so the 127.0.0.1:8384 host port
# mapping can reach it; the host side stays localhost-only (see the Compose
# ports). Edit this in the wdm template, not here: wdm regenerates this file
# on update.
STGUIADDRESS=0.0.0.0:8384

# --- Synced folder path (catalog placeholder, type: path) -------------------
# Absolute user-host path validated by internal/core at install planning time
# Path must exist, must be absolute, and must NOT live
# inside the stack directory; Syncthing mounts it read-write at /data.
SYNC_PATH={{ .SYNC_PATH }}

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_SYNCTHING={{ .MEMORY_LIMIT_SYNCTHING }}
CPUS_LIMIT_SYNCTHING={{ .CPUS_LIMIT_SYNCTHING }}
PIDS_LIMIT_SYNCTHING={{ .PIDS_LIMIT_SYNCTHING }}
