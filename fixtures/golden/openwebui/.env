# Open WebUI — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/openwebui/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update; regenerable=false
# secrets are read back from the existing .env at update time.

# --- Session signing (catalog placeholder, regenerable=false) ---------------
# WEBUI_SECRET_KEY signs session cookies. regenerable=false:
# rotating it logs every user out (no data loss), so wdm reuses the existing
# value via state.ReadStackEnv on update rather than churning sessions.
WEBUI_SECRET_KEY=TESTONLY-FAKE-SECRET-WEBUI_SECRET_KEY-0000000000000000000000000000

# --- Authentication (catalog-fixed literal) ---------------------------------
# Authentication is required; the first account created becomes the admin.
# Fixed literal, not a placeholder — referenced as ${WEBUI_AUTH} in compose.
WEBUI_AUTH=true

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps). wdm resolves empty input to the host
# timezone at install planning time.
TZ=Etc/UTC

# --- Model provider (optional — uncomment ONE to connect a model) -----------
# Open WebUI is a front-end only: without a provider it boots and serves the
# UI but cannot chat. env_file picks these up automatically — no compose edit
# needed. See README "Connecting a model provider".
#   Local Ollama on the host (reachable from the container):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
#   External OpenAI-compatible API:
# OPENAI_API_KEY=
#   Single sign-on (see the Open WebUI docs for the full OAUTH_* set):
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_OPENWEBUI=2g
CPUS_LIMIT_OPENWEBUI=1.0
PIDS_LIMIT_OPENWEBUI=300
