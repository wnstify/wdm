# AppFlowy Cloud — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/appflowy/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file. The
# --env-file loader does NOT do recursive ${VAR} interpolation, so every
# composite URL / connection string below is pre-flattened to concrete values.
# DO NOT edit by hand — wdm regenerates this on update; regenerable=false
# secrets are read back from the existing .env at update time.
#
# SMTP and OAuth keys are intentionally absent. To enable them, add the keys to
# ~/docker/appflowy/.env.user (see README). GOTRUE_MAILER_AUTOCONFIRM defaults
# to true so admin login + signup work with no mail server.

# --- Public domain --------------------------------------------------------
# Persisted as its own key so `wdm apps update` can read it back on rewrite.
# Every public URL below is pre-flattened from this value (the --env-file
# loader does no recursive ${VAR} interpolation).
DOMAIN=n8n.test.example

# --- Postgres identifiers + connection (catalog-fixed literals) ---
POSTGRES_USER=appflowy
POSTGRES_DB=appflowy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Postgres credential (catalog placeholder, regenerable=false) -----------
# regenerable=false: rotation requires ALTER USER inside the postgres container,
# which wdm does not orchestrate. Update reuses the existing value.
POSTGRES_PASSWORD=TESTONLY-FAKE-SECRET-POSTGRES_PASSWORD-0000000000000000000000000000

# --- Flattened connection strings (no recursive interpolation at --env-file) -
APPFLOWY_DATABASE_URL=postgres://appflowy:TESTONLY-FAKE-SECRET-POSTGRES_PASSWORD-0000000000000000000000000000@postgres:5432/appflowy
APPFLOWY_DATABASE_MAX_CONNECTIONS=40
GOTRUE_DATABASE_URL=postgres://appflowy:TESTONLY-FAKE-SECRET-POSTGRES_PASSWORD-0000000000000000000000000000@postgres:5432/appflowy?search_path=auth
APPFLOWY_WORKER_DATABASE_URL=postgres://appflowy:TESTONLY-FAKE-SECRET-POSTGRES_PASSWORD-0000000000000000000000000000@postgres:5432/appflowy
APPFLOWY_WORKER_DATABASE_NAME=appflowy

# --- Dragonfly (Redis-compatible) credential (regenerable=false) ------------
DRAGONFLY_PASSWORD=TESTONLY-FAKE-SECRET-DRAGONFLY_PASSWORD-0000000000000000000000000000
APPFLOWY_REDIS_URI=redis://default:TESTONLY-FAKE-SECRET-DRAGONFLY_PASSWORD-0000000000000000000000000000@dragonfly:6379
APPFLOWY_WORKER_REDIS_URL=redis://default:TESTONLY-FAKE-SECRET-DRAGONFLY_PASSWORD-0000000000000000000000000000@dragonfly:6379

# --- MinIO / S3 -------------------------------------------------------------
# MINIO_ROOT_USER + S3 access key are a catalog-fixed identifier; the root
# password is the generated secret (regenerable=false).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=TESTONLY-FAKE-SECRET-MINIO_ROOT_PASSWORD-0000000000000000000000000000
APPFLOWY_S3_USE_MINIO=true
APPFLOWY_S3_MINIO_URL=http://minio:9000
APPFLOWY_S3_CREATE_BUCKET=true
APPFLOWY_S3_ACCESS_KEY=minioadmin
APPFLOWY_S3_SECRET_KEY=TESTONLY-FAKE-SECRET-MINIO_ROOT_PASSWORD-0000000000000000000000000000
APPFLOWY_S3_BUCKET=appflowy
APPFLOWY_S3_REGION=us-east-1
APPFLOWY_S3_PRESIGNED_URL_ENDPOINT=https://n8n.test.example/minio-api

# --- GoTrue authentication --------------------------------------------------
# GOTRUE_ADMIN_PASSWORD seeds the admin account; plaintext by design (GoTrue
# reads it directly). GOTRUE_JWT_SECRET must match across gotrue + appflowy_cloud.
GOTRUE_ADMIN_EMAIL=admin@n8n.test.example
GOTRUE_ADMIN_PASSWORD=TESTONLY-FAKE-SECRET-GOTRUE_ADMIN_PASSWORD-0000000000000000000000000000
GOTRUE_JWT_SECRET=TESTONLY-FAKE-SECRET-GOTRUE_JWT_SECRET-0000000000000000000000000000
GOTRUE_JWT_EXP=604800
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_MAILER_AUTOCONFIRM=true
API_EXTERNAL_URL=https://n8n.test.example/gotrue
APPFLOWY_GOTRUE_BASE_URL=http://gotrue:9999

# --- Public URLs (flattened from DOMAIN) ------------------------------------
APPFLOWY_BASE_URL=https://n8n.test.example
APPFLOWY_WEB_URL=https://n8n.test.example
APPFLOWY_WEBSOCKET_BASE_URL=wss://n8n.test.example/ws/v2

# --- Access control ---------------------------------------------------------
APPFLOWY_ACCESS_CONTROL=true

# --- Logging ----------------------------------------------------------------
RUST_LOG=info

# --- Locale -----------------------------------------------------------------
# Container timezone. wdm resolves empty input to the host timezone at install.
TZ=Etc/UTC
