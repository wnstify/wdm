# Baserow — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/baserow/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update; regenerable=false
# secrets are read back from the existing .env at update time.

# --- Postgres identifiers (catalog-fixed literals) ---
# Postgres role and database names are SQL identifiers — they cannot be
# parameterized via SQL placeholders, only quoted string values can. The
# init-data.sh sidecar interpolates these via shell expansion inside CREATE
# USER / GRANT statements, so the values are fixed at the catalog/template
# layer and never user-supplied. Passwords below DO flow through as quoted
# SQL string literals — crypto/rand entropy makes identifier injection
# structurally impossible.
POSTGRES_USER=baserow_admin
POSTGRES_DB=baserow
POSTGRES_NON_ROOT_USER=baserow

# --- Postgres credentials (catalog placeholders, regenerable=false) ---------
# regenerable=false: rotating these post-install requires ALTER USER inside
# the postgres container, which wdm does not orchestrate. Update path reuses
# the existing values via state.ReadStackEnv.
POSTGRES_PASSWORD=TESTONLY-FAKE-SECRET-POSTGRES_PASSWORD-0000000000000000000000000000
POSTGRES_NON_ROOT_PASSWORD=TESTONLY-FAKE-SECRET-POSTGRES_NON_ROOT_PASSWORD-0000000000000000000000000000

# --- Baserow secrets (catalog placeholders, regenerable=false) --------------
# BASEROW_JWT_SIGNING_KEY: signs user-session JWTs. Rotating it logs every
# user out but does not lose data. regenerable=false.
BASEROW_JWT_SIGNING_KEY=TESTONLY-FAKE-SECRET-BASEROW_JWT_SIGNING_KEY-0000000000000000000000000000

# REDIS_PASSWORD: protects the Redis instance running inside the all-in-one
# container. Rotation requires a coordinated restart; regenerable=false.
REDIS_PASSWORD=TESTONLY-FAKE-SECRET-REDIS_PASSWORD-0000000000000000000000000000

# SECRET_KEY: Django per-deployment secret (CSRF tokens, signed cookies).
# Rotating it invalidates outstanding signed cookies/tokens; regenerable=false.
SECRET_KEY=TESTONLY-FAKE-SECRET-SECRET_KEY-0000000000000000000000000000

# --- Public URL (derived via env templating) ---
# BASEROW_PUBLIC_URL is computed from BASEROW_DOMAIN so the user supplies one
# input. NO trailing slash — baserow appends its own.
BASEROW_PUBLIC_URL=https://n8n.test.example

# --- File ownership (PUID/PGID — built-in template vars).
#     wdm resolves PUID = os.Getuid() and PGID = os.Getgid() at install
#     time so the baserow entrypoint chowns /baserow/data to the host user that
#     owns the stack directory. Never user-supplied. ------------------------
PUID=1000
PGID=1000

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scheduled tasks). wdm resolves empty
# input to the host timezone at install planning time.
TZ=Etc/UTC

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_POSTGRES=512m
CPUS_LIMIT_POSTGRES=0.5
PIDS_LIMIT_POSTGRES=200

MEMORY_LIMIT_BASEROW=3g
CPUS_LIMIT_BASEROW=1.0
PIDS_LIMIT_BASEROW=500
