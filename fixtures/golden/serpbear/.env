# SerpBear — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/serpbear/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update; regenerable=false
# secrets are read back from the existing .env at update time.

# --- Admin login ------------------------------------------------------------
# USER_NAME is the dashboard login username (user-configurable, default admin).
# PASSWORD is the login password — wdm generates it via crypto/rand. It is the
# credential you sign in with; the value lives only here. regenerable=false:
# rotating it invalidates the current login (no data loss).
SERPBEAR_USER=admin
SERPBEAR_PASSWORD=TESTONLY-FAKE-SECRET-SERPBEAR_PASSWORD-0000000000000000000000000000

# --- Session / API secrets (catalog placeholders, regenerable=false) --------
# SERPBEAR_SECRET signs session JWTs; rotation logs everyone out (no data
# loss). SERPBEAR_APIKEY is the REST bearer token; rotation breaks existing
# API clients (no data loss). Both regenerable=false, so wdm
# reuses the existing values on update via state.ReadStackEnv.
SERPBEAR_SECRET=TESTONLY-FAKE-SECRET-SERPBEAR_SECRET-0000000000000000000000000000
SERPBEAR_APIKEY=TESTONLY-FAKE-SECRET-SERPBEAR_APIKEY-0000000000000000000000000000

# --- Session lifetime -------------------------------------------------------
# Hours a session stays valid before re-login. Catalog-fixed literal, not a
# placeholder (the Compose template carries no default).
SESSION_DURATION=24

# --- Public URL (derived via env templating) ---
# NEXT_PUBLIC_APP_URL is computed from the single SERPBEAR_DOMAIN input so the
# user supplies one hostname. serpbear uses this for the CSRF origin, OAuth
# callbacks, and notification emails, so it must be the public reverse-proxy
# host. SERPBEAR_DOMAIN is persisted as its own key so the update path can
# read the recorded input back from the existing .env.
SERPBEAR_DOMAIN=n8n.test.example
NEXT_PUBLIC_APP_URL=https://n8n.test.example

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps). wdm resolves empty input to the host
# timezone at install planning time.
TZ=Etc/UTC

# --- Optional integrations (hints; not wdm placeholders) --------------------
# Google Search Console (uncomment + fill to import real ranking data):
#   SEARCH_CONSOLE_CLIENT_EMAIL=
#   SEARCH_CONSOLE_PRIVATE_KEY=
# SMTP for email notifications (uncomment + fill to enable alert emails):
#   SMTP_SERVER=
#   SMTP_PORT=
#   SMTP_USERNAME=
#   SMTP_PASSWORD=

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_SERPBEAR=512m
CPUS_LIMIT_SERPBEAR=0.5
PIDS_LIMIT_SERPBEAR=200
