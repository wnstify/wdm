# Dockhand — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/dockhand/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update; regenerable=false
# secrets are read back from the existing .env at update time.

# --- Postgres identity + credentials ----------------------------------------
# Dockhand owns its database outright: PG_USER is the superuser the postgres
# entrypoint creates from POSTGRES_USER, and the same value is composed into
# DATABASE_URL below. PG_USER / PG_DB are catalog string placeholders (default
# dockhand); PG_PASS is a regenerable=false secret — postgres applies it only on
# fresh init, so rotating it would require ALTER USER orchestration wdm does not
# do. The update path reuses the existing value via state.ReadStackEnv.
PG_USER=dockhand
PG_DB=dockhand
PG_PASS=TESTONLY-FAKE-SECRET-PG_PASS-0000000000000000000000000000

# --- File ownership (PUID/PGID — built-in template vars).
#     wdm resolves PUID = os.Getuid() and PGID = os.Getgid() at install
#     time. The dockhand entrypoint starts as root, chowns /app/data, then drops
#     the server to this uid:gid; omitting them would keep it running as root.
#     Never user-supplied. ----------------------------------------------------
PUID=1000
PGID=1000

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scheduled tasks). wdm resolves empty
# input to the host timezone at install planning time.
TZ=Etc/UTC

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_POSTGRESQL=512m
CPUS_LIMIT_POSTGRESQL=0.5
PIDS_LIMIT_POSTGRESQL=100

MEMORY_LIMIT_SOCKET_PROXY=32m
CPUS_LIMIT_SOCKET_PROXY=0.25
PIDS_LIMIT_SOCKET_PROXY=50

MEMORY_LIMIT_DOCKHAND=512m
CPUS_LIMIT_DOCKHAND=0.5
PIDS_LIMIT_DOCKHAND=200
