# Auto-generated by wdm — do not edit manually
# Stoat application secrets (REVOLT__ prefix maps to Revolt.toml sections).
# Consumed via env_file by the eight Rust services. wdm renders this from the
# placeholder map at install (mode 0600) and reuses regenerable=false values on
# update.

# Database connections (with auth)
REVOLT__DATABASE__MONGODB=mongodb://stoat:TESTONLY-FAKE-SECRET-MONGO_ROOT_PASSWORD-0000000000000000000000000000@database:27017/revolt?authSource=admin
REVOLT__DATABASE__REDIS=redis://:TESTONLY-FAKE-SECRET-REDIS_PASSWORD-0000000000000000000000000000@redis:6379/

# RabbitMQ
REVOLT__RABBIT__HOST=rabbit
REVOLT__RABBIT__PORT=5672
REVOLT__RABBIT__USERNAME=stoatrabbit
REVOLT__RABBIT__PASSWORD=TESTONLY-FAKE-SECRET-RABBIT_PASSWORD-0000000000000000000000000000

# Garage S3 file storage
REVOLT__FILES__S3__ENDPOINT=http://garage:3900
REVOLT__FILES__S3__ACCESS_KEY_ID=TESTONLY-FAKE-SECRET-S3_ACCESS_KEY-0000000000000000000000000000
REVOLT__FILES__S3__SECRET_ACCESS_KEY=TESTONLY-FAKE-SECRET-S3_SECRET_KEY-0000000000000000000000000000
REVOLT__FILES__S3__DEFAULT_BUCKET=revolt-uploads
REVOLT__FILES__S3__REGION=garage
REVOLT__FILES__S3__PATH_STYLE_BUCKETS=true
# File-attachment encryption key (AES-256-GCM, autumn decodes it as STANDARD
# base64 of exactly 32 bytes). wdm generates this with the base64std encoding
# (standard base64 of 32 random bytes), so file/avatar/image uploads work out
# of the box.
REVOLT__FILES__ENCRYPTION_KEY=TESTONLY-FAKE-SECRET-FILES_ENCRYPTION_KEY-0000000000000000000000000000

# Push notification VAPID keys. V1 SKIP — left empty: pushd starts with browser
# push disabled (wdm cannot mint the EC P-256 keypair).
REVOLT__PUSHD__VAPID__PRIVATE_KEY=
REVOLT__PUSHD__VAPID__PUBLIC_KEY=

# LiveKit voice
REVOLT__API__LIVEKIT__NODES__WORLDWIDE__KEY=TESTONLY-FAKE-SECRET-LIVEKIT_KEY-0000000000000000000000000000
REVOLT__API__LIVEKIT__NODES__WORLDWIDE__SECRET=TESTONLY-FAKE-SECRET-LIVEKIT_SECRET-0000000000000000000000000000
