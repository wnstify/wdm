# Mira (Miracode) — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/mira/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update; regenerable=false
# secrets are read back from the existing .env at update time.

# --- Postgres identifiers (catalog-fixed literals) ---
# Role and database names are catalog-fixed; only the password is generated.
POSTGRES_USER=mira
POSTGRES_DB=mira

# --- Postgres credentials (catalog placeholder, regenerable=false) ----------
# regenerable=false: rotating it post-install requires ALTER USER inside the
# postgres container, which wdm does not orchestrate. Update path reuses the
# existing value via state.ReadStackEnv. base64url-encoded so it carries no
# ':' / '@' / '$' that would break the DATABASE_URL mira connects with.
POSTGRES_PASSWORD=TESTONLY-FAKE-SECRET-POSTGRES_PASSWORD-0000000000000000000000000000

# --- Dashboard admin (catalog placeholder, regenerable=false) ---------------
# Username is always 'admin'; this is its password. Created once on first boot
# into the index store; changing it later does not update the existing admin.
ADMIN_PASSWORD=TESTONLY-FAKE-SECRET-ADMIN_PASSWORD-0000000000000000000000000000

# --- GitHub App credentials (user-supplied via --set) -----------------------
# These come from your GitHub App registration, not from wdm. The private key
# is a host file mounted into the container (MIRA_GITHUB_PRIVATE_KEY points at
# it with the '@' prefix); the value below is not the key itself.
MIRA_GITHUB_APP_ID=test-mira_github_app_id
MIRA_WEBHOOK_SECRET=test-mira_webhook_secret

# --- LLM provider (user-supplied via --set) ---------------------------------
OPENROUTER_API_KEY=test-openrouter_api_key

# --- Primary model (catalog-fixed default; tune live in the dashboard) ------
MIRA_MODEL=anthropic/claude-sonnet-4-6

# --- GitHub App private key host path (user-supplied via --set) -------------
# Absolute host path to the PEM downloaded from GitHub. Mounted read-only at
# /keys/github-app.pem; validated by internal/core at install planning time.
MIRA_PEM_PATH=/srv/test/mira_pem

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scheduled tasks). wdm resolves empty
# input to the host timezone at install planning time.
TZ=Etc/UTC

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_POSTGRES=512m
CPUS_LIMIT_POSTGRES=0.5
PIDS_LIMIT_POSTGRES=200

MEMORY_LIMIT_MIRA=1g
CPUS_LIMIT_MIRA=1.0
PIDS_LIMIT_MIRA=200
