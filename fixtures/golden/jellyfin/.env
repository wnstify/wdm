# Jellyfin — environment file (wdm-rendered)
#
# wdm writes this to ~/docker/jellyfin/.env with mode 0600 at install time.
# Compose binds these values at `docker compose up -d` via --env-file.
# DO NOT edit by hand — wdm regenerates this on update.

# --- LSIO image conventions (PUID/PGID — built-in template vars).
#     wdm resolves PUID = os.Getuid() and PGID = os.Getgid()
#     at install time so jellyfin's s6-overlay drops privileges to the host
#     user that owns the stack directory. Never user-supplied. -------------
PUID=1000
PGID=1000

# --- Locale -----------------------------------------------------------------
# Container timezone (log timestamps + scheduled tasks). wdm resolves empty
# input to the host timezone at install planning time.
TZ=Etc/UTC

# --- File-creation mask -----------------------------------------------------
# 022 = files 644 / dirs 755. Use 002 if you need group-writable shared media.
UMASK=022

# --- Media library paths (catalog placeholders, type: path) ----------------
# Absolute user-host paths validated by internal/core at install planning
# Paths must exist, must be absolute, and must
# NOT live inside the stack directory; jellyfin mounts them read-only.
MEDIA_PATH=/srv/test/media
MOVIES_PATH=/srv/test/movies
SHOWS_PATH=/srv/test/shows

# --- Resource limits (per-service, derived from catalog resources[].service
#     via the SERVICE_KEY transform). wdm selects recommended/min at
#     install planning time per the selection contract.
MEMORY_LIMIT_JELLYFIN=1g
CPUS_LIMIT_JELLYFIN=2.0
PIDS_LIMIT_JELLYFIN=500
